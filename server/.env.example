# Django Settings
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=True
TIME_ZONE=Asia/Kolkata

# Database Settings
# Note: DB_PORT is 6432 if using pgBouncer, or 5432 for direct Postgres connection
DB_NAME=nmpralekh
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1
DB_PORT=6432

# Redis Settings
REDIS_URL=redis://127.0.0.1:6379

# CORS & Security
# Comma-separated list of allowed frontend origins.
# In production replace with your actual frontend domain: https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://localhost:5173,https://localhost:5174
CSRF_TRUSTED_ORIGINS=https://localhost:5173,https://localhost:5174

# Comma-separated list of allowed host headers.
# In production replace with your actual backend domain: api.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# VITE ENVIRONMENT VARIABLES
# ==============================================================================
# Variables must start with VITE_ to be exposed to the client-side source code.

# For local development with the Vite proxy (which forwards /api to Nginx),
# leave this as '/api' or entirely commented out.
#
# For production deployments on Vercel/Amplify with a decoupled EC2 backend,
# set this to the full URL of your EC2 backend (e.g., https://api.nmpralekh.com/api)
VITE_API_BASE_URL=/api

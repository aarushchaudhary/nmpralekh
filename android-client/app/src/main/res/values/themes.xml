<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Same design language as the web app: brand palette, flat surfaces, 6dp corners, no shadows.
         Light only (the web app has no dark mode); the old values-night theme fell back to Material purple. -->
    <style name="Base.Theme.NMPralekh" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/red_600</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/red_50</item>
        <item name="colorOnPrimaryContainer">@color/red_800</item>
        <item name="colorSecondary">@color/gray_800</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/gray_100</item>
        <item name="colorOnSecondaryContainer">@color/gray_900</item>
        <item name="colorTertiary">@color/gray_600</item>
        <item name="colorError">@color/red_600</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:colorBackground">@color/gray_50</item>
        <item name="colorOnBackground">@color/gray_900</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/gray_900</item>
        <item name="colorSurfaceVariant">@color/gray_100</item>
        <item name="colorOnSurfaceVariant">@color/gray_600</item>
        <item name="colorSurfaceContainerLowest">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="colorSurfaceContainerHighest">@color/gray_100</item>
        <item name="colorOutline">@color/gray_300</item>
        <item name="colorOutlineVariant">@color/gray_200</item>
        <item name="colorControlNormal">@color/gray_600</item>
        <item name="android:textColorPrimary">@color/gray_900</item>
        <item name="android:textColorSecondary">@color/gray_600</item>
        <item name="android:textColorHint">@color/gray_500</item>

        <!-- 6dp corners everywhere (web: rounded-md) -->
        <item name="shapeAppearanceCornerExtraSmall">@style/Shape.NMPralekh</item>
        <item name="shapeAppearanceCornerSmall">@style/Shape.NMPralekh</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.NMPralekh</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.NMPralekh</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/Shape.NMPralekh</item>

        <item name="materialButtonStyle">@style/Widget.NMPralekh.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.NMPralekh.Button.Secondary</item>
        <item name="textInputStyle">@style/Widget.NMPralekh.TextInput</item>
        <item name="materialCardViewStyle">@style/Widget.NMPralekh.Card</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.NMPralekh.Dialog</item>
        <item name="drawerArrowStyle">@style/Widget.NMPralekh.DrawerArrow</item>

        <!-- white status bar with dark icons, like the web top bar. DrawerLayout paints the
             status-bar area with colorPrimaryDark, which Material 3 makes the primary red. -->
        <item name="colorPrimaryDark">@color/white</item>
        <item name="android:colorPrimaryDark">@color/white</item>
        <!-- Material 3 tints raised surfaces (dialogs, menus) with the primary red; keep them white -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.NMPralekh" parent="Base.Theme.NMPralekh" />

    <style name="Shape.NMPralekh" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>

    <!-- Buttons: primary = red (one per view), Secondary = white bordered, Danger = red text/border -->
    <style name="Widget.NMPralekh.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">6dp</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Widget.NMPralekh.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/gray_800</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">6dp</item>
        <item name="strokeColor">@color/gray_300</item>
        <item name="rippleColor">@color/gray_100</item>
    </style>
    <style name="Widget.NMPralekh.Button.Danger" parent="Widget.NMPralekh.Button.Secondary">
        <item name="android:textColor">@color/red_700</item>
        <item name="strokeColor">@color/red_200</item>
        <item name="rippleColor">@color/red_50</item>
    </style>
    <style name="Widget.NMPralekh.Button.Small" parent="Widget.NMPralekh.Button.Secondary">
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    <style name="Widget.NMPralekh.Button.Small.Danger" parent="Widget.NMPralekh.Button.Small">
        <item name="android:textColor">@color/red_700</item>
        <item name="strokeColor">@color/red_200</item>
        <item name="rippleColor">@color/red_50</item>
    </style>
    <style name="Widget.NMPralekh.Button.Small.Primary" parent="Widget.NMPralekh.Button">
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Widget.NMPralekh.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/red_600</item>
        <item name="boxCornerRadiusTopStart">6dp</item>
        <item name="boxCornerRadiusTopEnd">6dp</item>
        <item name="boxCornerRadiusBottomStart">6dp</item>
        <item name="boxCornerRadiusBottomEnd">6dp</item>
        <item name="hintTextColor">@color/red_700</item>
    </style>

    <!-- Panels: white, 1dp gray_200 border, 6dp corners, no shadow -->
    <style name="Widget.NMPralekh.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">6dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/gray_200</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="ThemeOverlay.NMPralekh.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/Shape.NMPralekh</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="materialAlertDialogTitleTextStyle">@style/NMPralekh.DialogTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.NMPralekh.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.NMPralekh.DialogButton.Cancel</item>
    </style>
    <style name="NMPralekh.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.Material3.TitleLarge</item>
        <item name="android:textColor">@color/gray_900</item>
    </style>
    <style name="ThemeOverlay.NMPralekh.Drawer" parent="">
        <!-- group dividers: faint on the dark grey drawer -->
        <item name="colorOutline">@color/white_10</item>
        <item name="colorOutlineVariant">@color/white_10</item>
    </style>
    <style name="Widget.NMPralekh.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/red_700</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.NMPralekh.DialogButton.Cancel">
        <item name="android:textColor">@color/gray_700</item>
    </style>

    <style name="Widget.NMPralekh.DrawerArrow" parent="Widget.AppCompat.DrawerArrowToggle">
        <item name="color">@color/gray_800</item>
    </style>

    <!-- Status badges: label text carries the meaning; style groups it (web Badge.jsx) -->
    <style name="Widget.NMPralekh.Badge" parent="">
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:background">@drawable/badge_gray</item>
        <item name="android:textColor">@color/gray_700</item>
    </style>
</resources>

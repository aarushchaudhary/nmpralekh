<?xml version="1.0" encoding="utf-8"?>
<!-- Role shell: white app bar with a hairline divider, dark NMIMS-grey drawer (web layout) -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/white"
            app:titleTextColor="@color/gray_900"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_200" />

        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/gray_50" />

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="264dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/gray_800"
        android:fitsSystemWindows="true"
        android:theme="@style/ThemeOverlay.NMPralekh.Drawer"
        app:drawerLayoutCornerSize="0dp"
        app:itemTextColor="@color/nav_item_text_color"
        app:itemTextAppearance="@style/TextAppearance.Material3.BodyMedium"
        app:itemBackground="@drawable/nav_item_background"
        app:itemHorizontalPadding="24dp"
        app:itemVerticalPadding="10dp"
        app:subheaderColor="@color/gray_400"
        app:subheaderTextAppearance="@style/TextAppearance.Material3.LabelSmall"
        app:dividerInsetStart="20dp"
        app:dividerInsetEnd="20dp"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu_deleteauth" />

</androidx.drawerlayout.widget.DrawerLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard (web DashboardHome): title + schools, one ruled strip of KPI tiles, plain note -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_50"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="Welcome"
            android:textColor="@color/gray_900"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvSchools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Loading schools..."
            android:textColor="@color/gray_600"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"
            android:indeterminateTint="@color/red_600"
            android:visibility="visible" />

        <!-- KPI strip: 1dp gaps over gray_200 draw the rules between white tiles -->
        <GridLayout
            android:id="@+id/gridModules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/kpi_strip_bg"
            android:columnCount="2"
            android:padding="1dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="You can create and view records for your school. Updates and deletions are sent for approval before they apply."
            android:textColor="@color/gray_600"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
